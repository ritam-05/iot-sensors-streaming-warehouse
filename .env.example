# AWS SQS queue used by the telemetry generator and ETL consumer.
TELEMETRY_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/iotstream-telemetry

# AWS SQS queue that receives transformed records for warehouse loading.
WAREHOUSE_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/iotstream-warehouse

# DynamoDB table that stores the latest state for each device.
DYNAMODB_TABLE_NAME=iotstream_device_state

# MotherDuck access token, used by warehouse tooling when configured.
MOTHERDUCK_TOKEN=your_motherduck_token
